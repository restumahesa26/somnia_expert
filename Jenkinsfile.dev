pipeline {
    agent any
    environment {
        IMAGE_NAME = "somnia-app-dev"
        CONTAINER_NAME = "somnia-staging"
        PORT = "8080" // Ini Port Laptop (Boleh 8080)
        PATH_SECRETS = "/var/jenkins_home/secrets"
    }
    stages {
        stage('Build Image Dev') {
            steps {
                script {
                    echo "🔨 [DEV] Membangun Image Dev..."
                    sh 'cp .env.example .env'
                    // Kita pakai tag 'dev' saja biar selalu tertimpa (hemat storage)
                    sh "docker build -t ${IMAGE_NAME}:dev ."
                }
            }
        }
        stage('Deploy Staging') {
            steps {
                script {
                    echo "🚀 [DEV] Deploy ke Port ${PORT}..."
                    sh "docker rm -f ${CONTAINER_NAME} || true"
                    sh "docker network create laravel-net || true"

                    // Kita tambahkan perintah 'php artisan serve' di bagian paling belakang
                    // Host 0.0.0.0 PENTING agar bisa diakses dari luar container
                    sh """
                        docker run -d --name ${CONTAINER_NAME} \
                        -p ${PORT}:8000 \
                        --network laravel-net \
                        -v ${PATH_SECRETS}/.env.staging:/var/www/.env \
                        ${IMAGE_NAME}:dev \
                        php artisan serve --host=0.0.0.0 --port=8000
                    """

                    sleep 5

                    // Migrate tetap jalan
                    sh "docker exec ${CONTAINER_NAME} php artisan migrate --force"

                    // Fix Permission (Sering bikin layar putih kalau storage gak bisa ditulis)
                    sh "docker exec ${CONTAINER_NAME} chmod -R 777 storage bootstrap/cache"
                }
            }
        }
    }
}
